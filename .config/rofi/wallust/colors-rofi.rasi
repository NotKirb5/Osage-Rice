background-color: #060004;
background: rgba(0,0,0,0.7);
foreground: #FAF9FB;
border-color: #72C9E7;

color0: #060004;
color1: #412E3C;
color2: #435679;
color3: #9B81A0;
color4: #5697AD;
color5: #A69861;
color6: #B4B3B7;
color7: #EFEFF1;
color8: #A7A7A9;
