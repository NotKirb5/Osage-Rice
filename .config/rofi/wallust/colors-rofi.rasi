 /* wallust template - colors-rofi */

* {
active-background: #72C9E7;
active-foreground: #FAF9FB;
normal-background: #060004;
normal-foreground: #FAF9FB;
urgent-background: #DDCB81;
urgent-foreground: #FAF9FB;

alternate-active-background: #CFACD5;
alternate-active-foreground: #FAF9FB;
alternate-normal-background: #060004;
alternate-normal-foreground: #FAF9FB;
alternate-urgent-background: #060004;
alternate-urgent-foreground: #FAF9FB;

